rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demonstração escolar SEM LOGIN: histórico público, sem dados pessoais.
    // Para um app privado, adicione autenticação antes de publicar.
    match /training_results/{resultId} {
      function active() { return request.time < timestamp.date(2026, 12, 31); }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['score', 'total', 'review', 'date'])
          && d.keys().hasOnly(['score', 'total', 'review', 'date'])
          && d.total == 5 && d.score is int && d.score >= 0 && d.score <= 5
          && d.review is list && d.review.size() == 5 - d.score
          && d.review.toSet().size() == d.review.size()
          && d.review.toSet().hasOnly([
            'Abacaxi', 'Água', 'Banana', 'Bicicleta', 'Cachorro',
            'Cadeira', 'Caderno', 'Café', 'Caneta', 'Carro',
            'Casa', 'Cavalo', 'Coelho', 'Escola', 'Gato',
            'Hospital', 'Lápis', 'Laranja', 'Leite', 'Livro',
            'Abelha', 'Mercado', 'Pão', 'Professor', 'Trem'
          ])
          && d.date is timestamp && d.date <= request.time
          && d.date > request.time - duration.value(1, 'h');
      }
      allow get: if active();
      allow list: if active() && request.query.limit <= 20;
      allow create: if active() && valid();
      // Repetir a gravação após falha de rede não duplica o resultado.
      allow update: if active() && request.resource.data == resource.data;
      allow delete: if false;
    }
  }
}
